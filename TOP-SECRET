<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TOP SECRET - Archivo Clasificado</title>
    <style>
        :root {
            --ts-red: #8a0303;
            --ts-dark: #0a0a0a;
            --ts-text: #e0e0e0;
            --ts-accent: #ff3333;
        }

        body {
            background-color: var(--ts-dark);
            color: var(--ts-text);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            position: relative;
        }

        /* Marca de agua */
        body::before {
            content: "CLASSIFIED";
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 15vw;
            color: rgba(138, 3, 3, 0.1);
            z-index: 0;
            pointer-events: none;
            white-space: nowrap;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        header {
            text-align: center;
            padding: 40px 0;
            border-bottom: 2px solid var(--ts-red);
            margin-bottom: 40px;
        }

        h1 {
            color: var(--ts-accent);
            text-transform: uppercase;
            letter-spacing: 5px;
            font-size: 3rem;
            text-shadow: 0 0 10px var(--ts-red);
        }

        .warning-banner {
            background: var(--ts-red);
            color: black;
            text-align: center;
            padding: 10px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        /* Mapa Section */
        .map-section {
            margin-bottom: 60px;
            position: relative;
            border: 1px solid var(--ts-red);
            padding: 20px;
            background: rgba(0,0,0,0.8);
        }

        .map-title {
            text-align: center;
            color: var(--ts-accent);
            margin-bottom: 20px;
            font-size: 1.5rem;
            text-transform: uppercase;
        }

        .map-container {
            width: 100%;
            height: 400px;
            background: #1a1a1a;
            position: relative;
            overflow: hidden;
            background-image: radial-gradient(#333 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .map-point {
            position: absolute;
            width: 15px;
            height: 15px;
            background-color: red;
            border-radius: 50%;
            box-shadow: 0 0 10px red;
            cursor: pointer;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.5); opacity: 0.7; }
            100% { transform: scale(1); opacity: 1; }
        }

        /* Botón oculto de edición de mapa */
        .map-edit-trigger {
            position: absolute;
            bottom: 10px;
            right: 10px;
            opacity: 0.1;
            cursor: pointer;
            z-index: 10;
            font-size: 20px;
        }
        .map-edit-trigger:hover { opacity: 1; }

        /* Carruseles */
        .section-title {
            border-left: 5px solid var(--ts-accent);
            padding-left: 15px;
            margin: 40px 0 20px 0;
            color: var(--ts-text);
            text-transform: uppercase;
        }

        .carousel-container {
            display: flex;
            overflow-x: auto;
            gap: 20px;
            padding: 20px 0;
            scrollbar-width: thin;
            scrollbar-color: var(--ts-red) var(--ts-dark);
        }

        .carousel-container::-webkit-scrollbar {
            height: 8px;
        }
        .carousel-container::-webkit-scrollbar-thumb {
            background: var(--ts-red);
        }

        .card {
            min-width: 300px;
            background: #111;
            border: 1px solid var(--ts-red);
            padding: 20px;
            transition: transform 0.3s;
            display: flex;
            flex-direction: column;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(138, 3, 3, 0.3);
        }

        .card-img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            background: #222;
            margin-bottom: 15px;
            border-bottom: 1px solid var(--ts-red);
        }

        .card-title {
            color: var(--ts-accent);
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .card-desc {
            font-size: 0.9rem;
            line-height: 1.4;
            color: #ccc;
            flex-grow: 1;
        }

        /* Bloqueo Overlay */
        #lock-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: black;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .lock-icon {
            font-size: 4rem;
            color: var(--ts-red);
            margin-bottom: 20px;
        }

        .access-input {
            background: transparent;
            border: 1px solid var(--ts-red);
            color: var(--ts-accent);
            padding: 10px;
            font-family: inherit;
            text-align: center;
            font-size: 1.2rem;
            margin-top: 20px;
            outline: none;
        }

        .hidden { display: none !important; }
        
        /* Botón volver */
        .back-btn {
            position: fixed;
            top: 20px;
            left: 20px;
            background: var(--ts-red);
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            z-index: 100;
            text-decoration: none;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <!-- Pantalla de Bloqueo -->
    <div id="lock-overlay">
        <div class="lock-icon">🔒</div>
        <h2>ACCESO RESTRINGIDO</h2>
        <p>Nivel de Seguridad: ULTRA SECRETO</p>
        <p>Ingrese credenciales de la Página 4 para desbloquear.</p>
        <p style="font-size: 0.8rem; color: #666; margin-top: 30px;">(Simulación: Si llegaste aquí directo, escribe cualquier cosa para entrar en modo demo)</p>
        <input type="password" id="unlock-code" class="access-input" placeholder="CÓDIGO DE ACCESO">
        <button onclick="checkAccess()" style="margin-top:10px; background:var(--ts-red); color:white; border:none; padding:10px 20px; cursor:pointer;">DESBLOQUEAR</button>
    </div>

    <a href="pagina-independiente_4.html" class="back-btn">← VOLVER AL PORTAL</a>

    <div class="container hidden" id="main-content">
        <div class="warning-banner">
            ⚠️ ADVERTENCIA: El acceso no autorizado a este material está prohibido por la ley de espionaje.
        </div>

        <header>
            <h1>Top Secret</h1>
            <p>Archivos Confidenciales de la Confederación</p>
        </header>

        <!-- Sección Mapa -->
        <section class="map-section">
            <h2 class="map-title">Aliados y Naciones pertenecientes a la confederación soviética</h2>
            <div class="map-container" id="world-map">
                <!-- Puntos generados por JS -->
                <div class="map-edit-trigger" onclick="editMap()">⚙️</div>
            </div>
        </section>

        <!-- Sección 1: Notas -->
        <h2 class="section-title">Documentos Críticos · Notas</h2>
        <div class="carousel-container" id="carousel-notes"></div>

        <!-- Sección 2: Documentos -->
        <h2 class="section-title">Documentos Críticos · Documentos</h2>
        <div class="carousel-container" id="carousel-docs"></div>

        <!-- Sección 3: Imágenes -->
        <h2 class="section-title">Documentos Críticos · Imágenes Exclusivas</h2>
        <div class="carousel-container" id="carousel-images"></div>
    </div>

    <script>
        // --- LÓGICA DE DATOS (LOCALSTORAGE) ---
        const defaultData = {
            mapPoints: [
                { top: '30%', left: '40%' }, // Ejemplo Europa
                { top: '40%', left: '70%' }, // Ejemplo Asia
                { top: '60%', left: '30%' }  // Ejemplo Sudamérica
            ],
            notes: [
                { title: "Operación Aurora", desc: "Informe sobre movimientos en la frontera norte.", img: "" },
                { title: "Código Rojo", desc: "Interceptación de comunicaciones enemigas.", img: "" }
            ],
            docs: [
                { title: "Plano Base Subterránea", desc: "Coordenadas exactas del bunker B-4.", img: "" },
                { title: "Lista de Activos", desc: "Agentes desplegados en territorio hostil.", img: "" }
            ],
            images: [
                { title: "Satélite Espía #402", desc: "Captura térmica del objetivo.", img: "" },
                { title: "Reunión Cumbre", desc: "Foto filtrada del encuentro secreto.", img: "" }
            ]
        };

        function getData() {
            const stored = localStorage.getItem('topSecretData');
            return stored ? JSON.parse(stored) : defaultData;
        }

        function saveData(data) {
            localStorage.setItem('topSecretData', JSON.stringify(data));
            renderAll();
        }

        // --- RENDERIZADO ---
        function renderAll() {
            const data = getData();
            
            // Render Mapa
            const mapContainer = document.getElementById('world-map');
            // Mantener el botón de editar
            const editBtn = mapContainer.querySelector('.map-edit-trigger');
            mapContainer.innerHTML = ''; 
            mapContainer.appendChild(editBtn);

            data.mapPoints.forEach(point => {
                const dot = document.createElement('div');
                dot.className = 'map-point';
                dot.style.top = point.top;
                dot.style.left = point.left;
                dot.title = "Punto Estratégico";
                mapContainer.appendChild(dot);
            });

            // Función auxiliar para renderizar carruseles
            const renderCarousel = (id, items) => {
                const container = document.getElementById(id);
                container.innerHTML = '';
                items.forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'card';
                    const imgSrc = item.img && item.img.startsWith('data:') ? item.img : 'https://via.placeholder.com/300x180/330000/ff0000?text=CLASIFIED';
                    
                    card.innerHTML = `
                        <img src="${imgSrc}" class="card-img" alt="${item.title}">
                        <div class="card-title">${item.title}</div>
                        <div class="card-desc">${item.desc}</div>
                    `;
                    container.appendChild(card);
                });
            };

            renderCarousel('carousel-notes', data.notes);
            renderCarousel('carousel-docs', data.docs);
            renderCarousel('carousel-images', data.images);
        }

        // --- SEGURIDAD Y ACCESO ---
        function checkAccess() {
            const input = document.getElementById('unlock-code').value;
            // En local, aceptamos cualquier cosa si viene directo, pero simulamos la lógica
            // La contraseña real sería validada si viniera de la pagina 4 via URL param o postMessage
            const overlay = document.getElementById('lock-overlay');
            const content = document.getElementById('main-content');
            
            overlay.style.opacity = '0';
            setTimeout(() => {
                overlay.classList.add('hidden');
                content.classList.remove('hidden');
            }, 500);
        }

        // Edición de Mapa (Oculta)
        function editMap() {
            const pass = prompt("Ingrese contraseña de administrador de mapa:");
            if(pass === "mapa2026") {
                alert("Modo edición de mapa activado. (Funcionalidad completa disponible en /admin)");
                window.location.href = "admin/editor.html#mapa";
            } else {
                alert("Acceso denegado.");
            }
        }

        // Inicializar
        window.addEventListener('DOMContentLoaded', () => {
            // Si hay datos en localStorage, usarlos, sino guardar defaults
            if(!localStorage.getItem('topSecretData')) {
                saveData(defaultData);
            }
            renderAll();
            
            // Checkear si viene desbloqueado desde pagina 4 (simulado)
            const urlParams = new URLSearchParams(window.location.search);
            if(urlParams.get('access') === 'granted') {
                checkAccess();
            }
        });
    </script>
</body>
</html>
